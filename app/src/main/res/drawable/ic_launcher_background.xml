<?xml version="1.0" encoding="utf-8"?>
<!--
  Adaptive-icon background. 108x108dp canvas; the launcher masks it to whatever shape the
  device uses, so this layer must be edge-to-edge with no detail near the corners.
  Gradient runs between the One UI blues in ui/theme/Color.kt (OneUIBlueLight -> OneUIBlueDark).
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="0"
                android:startY="0"
                android:endX="108"
                android:endY="108">
                <item android:color="#FF4C8DFA" android:offset="0.0" />
                <item android:color="#FF1B6BF3" android:offset="0.55" />
                <item android:color="#FF0F4AC6" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
