<?xml version="1.0" encoding="utf-8"?>
<!--
  Monochrome layer for Android 13+ themed icons. The system tints this a single colour and
  discards the background, so the glyph has to read without any fill contrast: the card is a
  stroke rather than a solid, with the ridgeline and sun solid inside it.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Card outline -->
    <path
        android:strokeColor="#FF000000"
        android:strokeWidth="4"
        android:fillColor="#00000000"
        android:pathData="M33,36 h42 a5,5 0 0 1 5,5 v26 a5,5 0 0 1 -5,5 h-42 a5,5 0 0 1 -5,-5 v-26 a5,5 0 0 1 5,-5 z" />

    <group>
        <clip-path
            android:pathData="M35,38 h38 a3,3 0 0 1 3,3 v26 a3,3 0 0 1 -3,3 h-38 a3,3 0 0 1 -3,-3 v-26 a3,3 0 0 1 3,-3 z" />

        <path
            android:fillColor="#FF000000"
            android:pathData="M41,48 m-4,0 a4,4 0 1,0 8,0 a4,4 0 1,0 -8,0" />

        <path
            android:fillColor="#FF000000"
            android:pathData="M24,74 L45,54 L56,66 L67,52 L84,74 Z" />
    </group>
</vector>
